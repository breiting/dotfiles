{
  "layer": "top",
  "position": "top",
  "height": 30,
  "spacing": 4,

  "modules-left": ["sway/workspaces", "sway/mode"],

  "modules-center": ["sway/window"],

  "modules-right": ["cpu", "network", "pulseaudio", "battery", "clock"],

  "sway/workspaces": {
    "disable-scroll": true,
    "all-outputs": false,
    "format": "{name}",
  },

  "sway/window": {
    "max-length": 55,
    "separate-outputs": true,
  },

  "sway/mode": {
    "format": "<span style=\"italic\">{}</span>",
  },

  "cpu": {
    "format": "  {usage}%",
    "tooltip": true,
    "on-click": "ghostty -e btop",
  },

  "network": {
    "format-wifi": "  {essid} ↓ {bandwidthDownBytes:>7}  ↑ {bandwidthUpBytes:>7}",
    "format-ethernet": "󰈀  ↓ {bandwidthDownBytes:>7}  ↑ {bandwidthUpBytes:>7}",
    "format-disconnected": "󰖪  offline",
    "tooltip-format-wifi": "{essid}\n{ifname}  {ipaddr}\n↓ {bandwidthDownBytes:>7}  ↑ {bandwidthUpBytes:>7}",
    "tooltip-format-ethernet": "{ifname}  {ipaddr}\n↓ {bandwidthDownBytes:>7}  ↑ {bandwidthUpBytes:>7}",
    "interval": 2,
  },

  "pulseaudio": {
    "format": "  {volume}%",
    "format-muted": "󰖁  mute",
    "scroll-step": 5,
    "on-click": "pavucontrol",
  },

  "battery": {
    "format": "{icon}  {capacity}%",
    "format-charging": "  {capacity}%",
    "format-icons": ["", "", "", "", ""],
    "states": {
      "warning": 25,
      "critical": 15,
    },
  },

  "clock": {
    "format": "  {:%d.%m.%Y %H:%M}",
    "tooltip-format": "<big>{:%A, %d. %B %Y}</big>\n<tt><small>{calendar}</small></tt>",
  },
}
