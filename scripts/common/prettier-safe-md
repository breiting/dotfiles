#!/usr/bin/env python3
"""Format Markdown with Prettier while preserving Setext headings."""

from __future__ import annotations

import os
import re
import shutil
import subprocess
import sys

START = "<!-- prettier-ignore-start -->"
END = "<!-- prettier-ignore-end -->"

prettier = os.environ.get("PRETTIER_BIN", "prettier")
if shutil.which(prettier) is None:
    print(f"Formatter not found: {prettier}", file=sys.stderr)
    raise SystemExit(127)

src = sys.stdin.read()
lines = src.splitlines()
out: list[str] = []

i = 0
while i < len(lines):
    current = lines[i]
    following = lines[i + 1] if i + 1 < len(lines) else ""

    if current.strip() and (
        re.fullmatch(r"=+\s*", following) or re.fullmatch(r"-+\s*", following)
    ):
        out.extend((START, current, following, END))
        i += 2
    else:
        out.append(current)
        i += 1

completed = subprocess.run(
    [prettier, "--parser", "markdown"],
    input="\n".join(out),
    text=True,
    capture_output=True,
)

if completed.returncode != 0:
    sys.stderr.write(completed.stderr)
    raise SystemExit(completed.returncode)

cleaned = "\n".join(
    line
    for line in completed.stdout.splitlines()
    if line.strip() not in {START, END}
)
sys.stdout.write(cleaned)
