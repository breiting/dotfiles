#!/usr/bin/env bash
set -u

CONFIG_DIR="${CONFIG_DIR:-$HOME/.config/sketchybar}"
PLUGIN_DIR="$CONFIG_DIR/plugins"

BAR_BG=0xff111111
ITEM_BG=0xff222222
FG=0xffdddddd
BLUE=0xff89b4fa
GREEN=0xffa6e3a1
YELLOW=0xfff9e2af

FONT="JetBrainsMono Nerd Font Propo"

sketchybar --bar \
    height=30 \
    position=top \
    color="$BAR_BG" \
    shadow=off \
    topmost=window \
    sticky=on \
    padding_left=6 \
    padding_right=6 \
    margin=0 \
    y_offset=0 \
    corner_radius=0 \
    blur_radius=0 \
    notch_width=0 \
    font_smoothing=on

sketchybar --default \
    icon.font="$FONT:Semibold:13.0" \
    icon.color="$FG" \
    label.font="$FONT:Medium:13.0" \
    label.color="$FG" \
    background.color="$ITEM_BG" \
    background.corner_radius=5 \
    background.height=23 \
    background.drawing=on \
    padding_left=7 \
    padding_right=7 \
    icon.padding_left=6 \
    icon.padding_right=4 \
    label.padding_left=3 \
    label.padding_right=6

sketchybar --add event aerospace_workspace_change

# Left side -------------------------------------------------------------------

for sid in 1 2 3 4 5 6 7 8 9 0; do
    sketchybar \
        --add item "space.$sid" left \
        --set "space.$sid" \
            icon.drawing=off \
            label="$sid" \
            background.color="$ITEM_BG" \
            click_script="aerospace workspace $sid" \
            script="$PLUGIN_DIR/workspace.sh $sid" \
        --subscribe "space.$sid" aerospace_workspace_change
done

# Keep app context next to the workspaces instead of in the notched center.
sketchybar \
    --add item front_app left \
    --set front_app \
        icon="󰘔" \
        background.drawing=off \
        label.max_chars=45 \
        script="$PLUGIN_DIR/front_app.sh" \
    --subscribe front_app front_app_switched

# Right side ------------------------------------------------------------------

sketchybar \
    --add item clock right \
    --set clock \
        icon="" \
        icon.color="$BLUE" \
        update_freq=30 \
        click_script='open "x-apple.systempreferences:com.apple.Date-Time-Settings.extension"' \
        script="$PLUGIN_DIR/clock.sh"

sketchybar \
    --add item battery right \
    --set battery \
        icon="" \
        icon.color="$YELLOW" \
        update_freq=30 \
        click_script='open "x-apple.systempreferences:com.apple.Battery-Settings.extension"' \
        script="$PLUGIN_DIR/battery.sh"

sketchybar \
    --add item volume right \
    --set volume \
        icon="" \
        click_script='open "x-apple.systempreferences:com.apple.Sound-Settings.extension"' \
        script="$PLUGIN_DIR/volume.sh" \
    --subscribe volume volume_change

sketchybar \
    --add item network right \
    --set network \
        icon="" \
        icon.color="$GREEN" \
        update_freq=5 \
        click_script='open "x-apple.systempreferences:com.apple.wifi-settings-extension"' \
        script="$PLUGIN_DIR/network.sh"

sketchybar \
    --add item cpu right \
    --set cpu \
        icon="" \
        update_freq=3 \
        click_script='open -a "Activity Monitor"' \
        script="$PLUGIN_DIR/cpu.sh"


sketchybar --update

focused="$(aerospace list-workspaces --focused 2>/dev/null | head -n 1 || true)"
if [[ -n "$focused" ]]; then
    sketchybar --trigger aerospace_workspace_change FOCUSED_WORKSPACE="$focused"
fi
