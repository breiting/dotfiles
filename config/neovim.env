# Neovim source-build configuration.
#
# Use an explicit release tag for reproducible workstation builds.
NEOVIM_VERSION="v0.12.5"

# The source tree is managed by install/neovim.sh.
NEOVIM_SOURCE_DIR="$HOME/.local/src/neovim"

# Install into the user's local prefix. ~/.local/bin is already part of PATH.
NEOVIM_INSTALL_PREFIX="$HOME/.local"
